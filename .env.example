# VetCampaignManager — environment variables
# Copy this file to `.env` for local dev. All vars are optional in the MVP
# (localStorage + settings-store webhook). They establish the pattern for the
# Supabase migration and production deployment.

# n8n webhook URL. When empty, the app runs in demo mode (payload built but
# not sent). Can be overridden per-clinic in Settings → Webhook.
VITE_N8N_WEBHOOK_URL=

# Supabase (Phase 2 — SaaS migration). Leave empty to keep using localStorage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry DSN for client-side error tracking in production. Empty = disabled.
VITE_SENTRY_DSN=
