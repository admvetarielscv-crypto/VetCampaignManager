# ─────────────────────────────────────────────────────────────────────────────
# VetCampaignManager — variables para el stack del VPS
# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo a `.env` y completá los valores antes de hacer
# `docker compose up -d`. NO commitees el `.env` real (ya está en .gitignore).

# IP pública de tu VPS. La podés ver con `curl ifconfig.me` dentro del VPS.
# Se usa para generar URLs de sslip.io si todavía no compraste un dominio.
VPS_IP=203.0.113.45

# ── Dominios (subdominios del VPS) ───────────────────────────────────────────
# Opción A — Gratis con sslip.io (no necesitás comprar dominio):
#   N8N_DOMAIN=n8n.203.0.113.45.sslip.io
#   EVO_DOMAIN=evo.203.0.113.45.sslip.io
#
# Opción B — Con tu propio dominio (recomendado para producción):
#   N8N_DOMAIN=n8n.tuclinica.com
#   EVO_DOMAIN=evo.tuclinica.com
#
# Reemplazá 203.0.113.45 por tu IP real (línea 1).
N8N_DOMAIN=n8n.203.0.113.45.sslip.io
EVO_DOMAIN=evo.203.0.113.45.sslip.io

# ── Let's Encrypt ────────────────────────────────────────────────────────────
# Email para los avisos de renovación de certificados HTTPS.
LETSENCRYPT_EMAIL=tu@correo.com

# ── n8n: credenciales del panel web ──────────────────────────────────────────
# Cambiá estos valores. Usuario y contraseña para entrar a https://N8N_DOMAIN
N8N_USER=admin
N8N_PASSWORD=cambiame-ya-por-algo-fuerte

# ── Evolution API: API key global ────────────────────────────────────────────
# Cualquier string aleatorio sirve. Lo necesitarás para crear instancias y
# enviar mensajes vía API. Generá uno fuerte: `openssl rand -hex 32`.
EVO_API_KEY=genera-con-openssl-rand-hex-32

# ── Postgres (solo para Evolution) ───────────────────────────────────────────
# Contraseña de la DB interna de Evolution API. No la necesitas para nada más.
POSTGRES_PASSWORD=cambiame-este-tambien
