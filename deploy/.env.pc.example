# ─────────────────────────────────────────────────────────────────────────────
# VetCampaignManager — variables para el stack "PC servidor" (piloto sin VPS)
# ─────────────────────────────────────────────────────────────────────────────
# Copiá este archivo a `.env.pc` y completá los valores antes de:
#   docker compose -f docker-compose.pc.yml --env-file .env.pc up -d
# NO commitees el `.env.pc` real (ya está en .gitignore).

# ── Tailscale ────────────────────────────────────────────────────────────────
# Hostname que Tailscale le asigna a la PC (lo ves con `tailscale status` o en
# la consola admin de Tailscale). Ej: mi-pc.mi-tailnet.ts.net
# Es el dominio público de n8n: https://mi-pc.mi-tailnet.ts.net/
TS_HOSTNAME=mi-pc.mi-tailnet.ts.net

# ── n8n: credenciales del panel web ──────────────────────────────────────────
# Cambiá estos valores. Usuario y contraseña para entrar al panel de n8n.
N8N_USER=admin
N8N_PASSWORD=cambiame-ya-por-algo-fuerte

# ── Evolution API: API key global ────────────────────────────────────────────
# Cualquier string aleatorio fuerte. Generá uno en PowerShell con:
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
EVO_API_KEY=genera-uno-aleatorio-fuerte

# ── Postgres (compartida: Evolution + n8n, por ahora) ────────────────────────
# Contraseña de la DB interna. No la necesitas para nada externo.
# Nota: n8n y Evolution comparten la MISMA DB ("evolution") en el piloto.
# Es deuda conocida documentada en docs/GUIA-SERVIDOR-LOCAL.md.
POSTGRES_PASSWORD=cambiame-este-tambien
